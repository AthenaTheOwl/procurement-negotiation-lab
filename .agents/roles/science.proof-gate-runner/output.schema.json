{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "science.proof-gate-runner output",
  "description": "Shape the gate runner writes when a sign-off run completes.",
  "type": "object",
  "required": ["run_id", "gates", "verdict"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Stable id for the gate run (factory task id, uuid hex, or CI run id)."
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per gate executed.",
      "items": {
        "type": "object",
        "required": ["name", "exit_code", "log_ref"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "exit_code": {"type": "integer"},
          "log_ref": {"type": "string"},
          "duration_seconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["green", "red"],
      "description": "green if every gate exited 0; red otherwise."
    },
    "failing_gates": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
