id: {TASK_ID}
title: "{BRAND} v0.1 data report"
target_repo: "{REPO}"
goal: |
  Ship {BRAND} as a useful v0.1 data-report repo. The repo must have a
  clear product brief, system map, specs/0002-design ledger, runnable
  Python CLI, tests, and one checked-in report artifact.

  STATUS.md section convention (REQUIRED — contract gate fails otherwise):
  - `STATUS.md` MUST have these THREE H2 sections, with these EXACT
    headings (case- and word-sensitive):

        ## Current state
        ## Known limits
        ## Next feature queue

    Do NOT rename to "Shipped" / "Done" / "Next" / "TODO" / "Roadmap" —
    the contract gate matches the literal strings above. Section bodies
    are bullet lists; the "Next feature queue" body becomes the input
    to the next factory run for this repo.

  Python packaging convention (REQUIRED — `python -m uv sync` + tests
  silently break otherwise):
  - In `pyproject.toml`, declare dev deps under `[dependency-groups]`,
    NOT `[project.optional-dependencies]`. uv installs dependency-groups
    automatically; optional-dependencies need an explicit `--extra` flag
    and won't reach the venv on a plain `uv sync`.
  - Add `[tool.uv]` with `package = true` so the project itself is
    editable-installed into the venv. Without it, `python -m uv run
    pytest` falls back to the system python and `from {SLUG} import X`
    raises ModuleNotFoundError even though the package exists on disk.
  - Build backend can be hatchling or setuptools — either works once
    the two uv blocks above are present.
active: true
template: data-report
product_vision: "Turns one public-data question into a small runnable report with a clear next action."
target_user: "operator or analyst who needs a first-pass data report"
first_user_action: "python -m {SLUG} validate"
system_layers:
  - ingest
  - model
  - report
next_feature_queue:
  - Add live source fetching with polite rate limits.
  - Add a second report scenario and compare outputs.
gates:
  - name: contract-presence
    cmd: python -c "from pathlib import Path; required=['PRODUCT_BRIEF.md','SYSTEM_MAP.md','STATUS.md','README.md','pyproject.toml']; missing=[p for p in required if not Path(p).exists()]; raise SystemExit('missing '+','.join(missing) if missing else 0)"
  - name: reports-present
    cmd: python -c "from pathlib import Path; reports=Path('reports'); raise SystemExit(0 if reports.exists() and any(reports.glob('*.jsonl')) else 'missing reports/*.jsonl')"
  - name: pyproject-uv-conventions
    must_pass: false
    cmd: |
      python -c "from pathlib import Path; t=Path('pyproject.toml').read_text(encoding='utf-8'); flags=[]; ('[project.optional-dependencies]' in t and 'dev' in t.split('[project.optional-dependencies]')[1].split('[')[0]) and flags.append('dev under optional-deps -- move to dependency-groups'); ('hatchling' in t and '[tool.uv]' not in t) and flags.append('hatchling without tool.uv package=true'); raise SystemExit('pyproject warnings - '+'; '.join(flags) if flags else 0)"
review:
  reviewer: claude_code
  reviewers:
    - claude_code
  max_patch_rounds: 2
pr:
  open: false
planner: claude_code
implementer: codex
