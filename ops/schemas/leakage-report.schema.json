{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://procurement-negotiation-lab.dev/schemas/leakage-report.schema.json",
  "title": "TranscriptExposureReport",
  "description": "Per-run transcript-exposure report for weighted-Nash mechanisms that do not send utility functions to the aggregator. Historical field and file names are retained for compatibility; this is not a differential-privacy guarantee. Pinned by DEC-NASH-002; mirrored from the Pydantic model in src/procurement_lab/engine/schemas.py.",
  "type": "object",
  "required": [
    "protocol_version",
    "run_id",
    "seed",
    "round_count",
    "per_party",
    "aggregate"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "description": "Protocol contract identifier. v1 today is 'transcript-exposure/v1'; 'bounded-leakage/v1' remains a legacy identifier."
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "round_count": {
      "type": "integer",
      "minimum": 0
    },
    "per_party": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TranscriptExposureParty"
      }
    },
    "aggregate": {
      "$ref": "#/$defs/AggregateTranscriptExposure"
    }
  },
  "$defs": {
    "TranscriptExposureParty": {
      "type": "object",
      "required": [
        "party_id",
        "epsilon_bound",
        "epsilon_measured",
        "round_count",
        "message_log_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "party_id": {
          "type": "string",
          "minLength": 1
        },
        "epsilon_bound": {
          "type": "number",
          "minimum": 0,
          "description": "Declared per-protocol-version upper bound on bits of utility-function information that the transcript reveals about this party; not a DP epsilon."
        },
        "epsilon_measured": {
          "type": "number",
          "minimum": 0,
          "description": "Measured per-run transcript-exposure upper bound in bits: round_count * (n_coords * log2(3) + log2(STEP_QUANTIZATION_LEVELS))."
        },
        "round_count": {
          "type": "integer",
          "minimum": 0
        },
        "message_log_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sufficiency_note": {
          "type": "string"
        }
      }
    },
    "AggregateTranscriptExposure": {
      "type": "object",
      "required": [
        "max_epsilon_measured",
        "max_epsilon_bound",
        "all_within_bound"
      ],
      "additionalProperties": false,
      "properties": {
        "max_epsilon_measured": {
          "type": "number",
          "minimum": 0
        },
        "max_epsilon_bound": {
          "type": "number",
          "minimum": 0
        },
        "all_within_bound": {
          "type": "boolean"
        }
      }
    }
  }
}
