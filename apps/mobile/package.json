{
  "name": "@lab/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node scripts/run-jest.cjs --watchAll=false",
    "test:ci": "node scripts/run-jest.cjs --ci",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "maestro:test": "maestro test .maestro/",
    "eas:build:development": "eas build --profile development --platform android --non-interactive",
    "eas:build:preview": "eas build --profile preview --platform android --non-interactive",
    "eas:build:production": "eas build --profile production --platform all --non-interactive"
  },
  "dependencies": {
    "@lab/engine": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-dom": "18.3.1",
    "react-native": "0.74.0",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "~3.31.0",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "babel-jest": "^30.4.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ]
  }
}
