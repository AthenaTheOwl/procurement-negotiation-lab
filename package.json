{
  "name": "procurement-negotiation-lab-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@lab/web",
    "build": "npm run build --workspace=@lab/web",
    "preview": "npm run preview --workspace=@lab/web",
    "test:engine": "npm run test --workspace=@lab/engine",
    "test:web": "npm run test --workspace=@lab/web -- --run",
    "test": "npm run test:engine && npm run test:web",
    "lint": "npm run lint --workspace=@lab/engine && npm run lint --workspace=@lab/web",
    "smoke": "npm run smoke --workspace=@lab/web"
  }
}
